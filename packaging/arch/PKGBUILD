# Arch Linux package for Hanabi (installs the release AppImage).
# Build & install:  cd packaging/arch && makepkg -si
# Before the first release, set _repo to your GitHub "owner/name".
pkgname=hanabi-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Learn Japanese in short, focused bursts: kana, all 2,136 Jōyō kanji, Anki-style decks, dictionary"
arch=('x86_64')
_repo="OWNER/hanabi"
url="https://github.com/${_repo}"
license=('custom')
depends=('fuse2' 'zlib' 'glibc')
optdepends=('chromium: open Hanabi in its own app window (any Chromium-based browser works)'
            'libnotify: "starting…" notification on first launch')
provides=('hanabi')
conflicts=('hanabi')
options=('!strip' '!debug')
source=("Hanabi-${pkgver}-x86_64.AppImage::${url}/releases/download/v${pkgver}/Hanabi-${pkgver}-x86_64.AppImage")
sha256sums=('SKIP')
noextract=("Hanabi-${pkgver}-x86_64.AppImage")

prepare() {
  chmod +x "Hanabi-${pkgver}-x86_64.AppImage"
  ./"Hanabi-${pkgver}-x86_64.AppImage" --appimage-extract hanabi.desktop >/dev/null
  ./"Hanabi-${pkgver}-x86_64.AppImage" --appimage-extract hanabi.png >/dev/null
}

package() {
  install -Dm755 "Hanabi-${pkgver}-x86_64.AppImage" "${pkgdir}/opt/hanabi/Hanabi.AppImage"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /opt/hanabi/Hanabi.AppImage "${pkgdir}/usr/bin/hanabi"
  install -Dm644 squashfs-root/hanabi.desktop "${pkgdir}/usr/share/applications/hanabi.desktop"
  install -Dm644 squashfs-root/hanabi.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/hanabi.png"
}
